# Copy to .env and fill in your MWAPI key and an allowed Claude model ID.
# No official OpenAI key is required.
LLM_API_KEY=
LLM_API_FORMAT=anthropic
LLM_BASE_URL=https://api.mwapi.dev
LLM_MODEL=
LLM_TIMEOUT=60

# Local embeddings for RAGAS; no remote embeddings API is used.
EVAL_EMBEDDING_MODEL=BAAI/bge-m3

# Optional OpenAI-compatible route (only if supported by your MWAPI account):
# LLM_API_FORMAT=openai
# LLM_BASE_URL=https://api.mwapi.dev/v1
